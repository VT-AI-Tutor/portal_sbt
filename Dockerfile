FROM node:22-alpine AS builder

WORKDIR /app
RUN chown node:node /app
USER node

COPY --chown=node:node package.json package-lock.json ./
# Nội bộ VT thêm proxy
RUN npm --proxy http://10.255.188.84:3128 ci --ignore-scripts --no-audit --no-fund

# RUN npm ci --ignore-scripts --no-audit --no-fund

COPY --chown=node:node . .

ARG VITE_API_BASE_URL
ARG VITE_API_PROVIDER
ARG VITE_CATALOG_API_BASE_URL
ARG VITE_CATALOG_API_PROVIDER
ARG VITE_LCMS_API_BASE_URL
ARG VITE_LCMS_MASTERY_API_BASE_URL
ARG VITE_LCMS_AUTH_BASE_URL
ARG VITE_GOOGLE_CLIENT_ID
ARG VITE_GOOGLE_TAG_ID
ARG VITE_THEME
ARG VITE_BRAND
ARG VITE_LANDING
ARG VITE_STUDENT_PAGE_ENABLED
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_EXERCISE_PASS
ARG VITE_DIGITIZED_EXERCISE_PASS_HASH
ARG VITE_DIGITIZED_CONTENT_BASE_URL
ARG VITE_LOADER_ADVANCE_QUESTION_API
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_API_PROVIDER=$VITE_API_PROVIDER \
    VITE_CATALOG_API_BASE_URL=$VITE_CATALOG_API_BASE_URL \
    VITE_CATALOG_API_PROVIDER=$VITE_CATALOG_API_PROVIDER \
    VITE_LCMS_API_BASE_URL=$VITE_LCMS_API_BASE_URL \
    VITE_LCMS_AUTH_BASE_URL=$VITE_LCMS_AUTH_BASE_URL \
    VITE_LCMS_MASTERY_API_BASE_URL=$VITE_LCMS_MASTERY_API_BASE_URL \
    VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID \
    VITE_GOOGLE_TAG_ID=$VITE_GOOGLE_TAG_ID \
    VITE_THEME=$VITE_THEME \
    VITE_BRAND=$VITE_BRAND \
    VITE_LANDING=$VITE_LANDING \
    VITE_STUDENT_PAGE_ENABLED=$VITE_STUDENT_PAGE_ENABLED \
    VITE_SUPABASE_URL=$VITE_SUPABASE_URL \
    VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY \
    VITE_EXERCISE_PASS=$VITE_EXERCISE_PASS \
    VITE_LOADER_ADVANCE_QUESTION_API=$VITE_LOADER_ADVANCE_QUESTION_API \
    VITE_DIGITIZED_EXERCISE_PASS_HASH=$VITE_DIGITIZED_EXERCISE_PASS_HASH \
    VITE_DIGITIZED_CONTENT_BASE_URL=$VITE_DIGITIZED_CONTENT_BASE_URL

RUN npm run build

FROM nginx:1.27-alpine AS runner

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
