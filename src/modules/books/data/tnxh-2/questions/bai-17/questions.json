          "id": "A",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Cá sẽ sống bình thường và thích nghi dần với cuộc sống trên cạn."
              }
            ]
          }
        },
        {
          "id": "B",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Cá sẽ sống một lúc do trời mưa, khi mưa tạnh và ở trên cạn lâu cá sẽ chết."
              }
            ]
          }
        },
        {
          "id": "C",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Cá càng ở lâu trên cạn sẽ càng khoẻ hơn và dùng vây, đuôi để trườn về ao."
              }
            ]
          }
        },
        {
          "id": "D",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Cá có thể dùng vây, đuôi quẫy mạnh và nếu không rơi lại xuống ao thì cá sẽ chết."
              }
            ]
          }
        }
      ]
