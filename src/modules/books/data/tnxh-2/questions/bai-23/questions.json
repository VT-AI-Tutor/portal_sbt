      "language": "vi",
      "content": {
        "blocks": [
          {
            "type": "paragraph",
            "text": "Quan sát hi ̀nh sau và khoanh vào chữ cái trước câu trả lời của em cho các câu hỏi dưới đây.  Mẹ ơi, mũi con bị ngạt, rất khó thở ạ!"
          }
        ]
      },
      "explanation": {
        "blocks": []
      },
      "hint": {
        "blocks": []
      },
      "metadata": {
        "lessonNumber": 23,
        "exerciseNumber": 5,
        "subPart": "",
        "bookId": "tnxh-2",
        "autoParsed": true
      },
      "settings": {
        "shuffleOptions": true,
        "partialScoring": false,
        "caseSensitive": false
      },
      "accessibility": {
        "altText": "",
        "transcript": "",
        "captions": ""
      },
      "options": [
        {
          "id": "A",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Bạn đang buồn ngủ nên thở nhanh hơn."
              }
            ]
          }
        },
        {
          "id": "B",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Bạn bị ngạt mũi nên cảm thấy khó chịu, khó thở."
              }
            ]
          }
        },
        {
          "id": "C",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Bạn đang chạy nhảy nên mệt."
              }
            ]
          }
        },
        {
          "id": "D",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Bạn đang đói bụng và cảm thấy khó thở. b) Vì sao bạn lại khó thở khi bị ngạt mũi?"
              }
            ]
          }
        },
        {
          "id": "A",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Vì bạn không ngủ đủ giấc."
              }
            ]
          }
        },
        {
          "id": "B",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Vì không khí khó ra, vào cơ thể do mũi bị ngạt."
              }
            ]
          }
        },
        {
          "id": "C",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Vì bạn không ăn đủ cơm."
              }
            ]
          }
        },
        {
          "id": "D",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Vì bạn lo lắng quá mức. c) Điều gì sẽ xảy ra với con người nếu cơ quan hô hấp không hoạt động?"
              }
            ]
          }
        },
        {
          "id": "A",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Con người vẫn sống bình thường nhưng sẽ mệt hơn."
              }
            ]
          }
        },
        {
          "id": "B",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Con người không thể vận động mạnh."
              }
            ]
          }
        },
        {
          "id": "C",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Con người không thể thở dẫn đến không sống được."
              }
            ]
          }
        },
        {
          "id": "D",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Con người sẽ dễ ngủ và cao lớn hơn."
              }
            ]
          }
        }
      ]
    }
