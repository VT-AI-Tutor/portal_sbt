    {
      "id": "tnxh2_bai21_q5",
      "type": "single_choice",
      "version": 1,
      "difficulty": "medium",
      "score": 1,
      "tags": [
        "tnxh_2",
        "grade_2",
        "bai_21"
      ],
      "language": "vi",
      "content": {
        "blocks": [
          {
            "type": "paragraph",
            "text": "Khoanh vào chữ cái trước phương án em lựa chọn để trả lời cho câu hỏi của bạn trong hi ̀nh dưới đây. Tại sao tay mình có thể gập lại, duỗi ra được nhỉ?"
          }
        ]
      },
      "explanation": {
        "blocks": []
      },
      "hint": {
        "blocks": []
      },
      "metadata": {
        "lessonNumber": 21,
        "exerciseNumber": 5,
        "subPart": "",
        "bookId": "tnxh-2",
        "autoParsed": true
      },
      "settings": {
        "shuffleOptions": true,
        "partialScoring": false,
        "caseSensitive": false
      },
      "accessibility": {
        "altText": "",
        "transcript": "",
        "captions": ""
      },
      "options": [
        {
          "id": "A",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Vì cơ, xương và khớp tay cùng phối hợp giúp tay gập và duỗi."
              }
            ]
          }
        },
        {
          "id": "B",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Vì tay chỉ cần có khớp xương là cử động được."
              }
            ]
          }
        },
        {
          "id": "C",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Vì tay có da nên tự chuyển động được."
              }
            ]
          }
        },
        {
          "id": "D",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Vì tay nhẹ nên có thể gập và duỗi nhanh chóng."
              }
            ]
          }
        }
      ]
    },
    {
      "id": "tnxh2_bai21_q50",
      "type": "single_choice",
      "version": 1,
      "difficulty": "medium",
      "score": 1,
      "tags": [
        "tnxh_2",
        "grade_2",
        "bai_21"
      ],
      "language": "vi",
      "content": {
        "blocks": [
          {
            "type": "paragraph",
            "text": "6 Quan sát các hình sau:  Khoanh vào chữ cái trước câu trả lời của em cho các câu hỏi từ a đến d. a)  Điều gì đã xảy ra với bạn gái trong hình trên?"
          }
        ]
      },
      "explanation": {
        "blocks": []
      },
      "hint": {
        "blocks": []
      },
      "metadata": {
        "lessonNumber": 21,
        "exerciseNumber": 50,
        "subPart": "",
        "bookId": "tnxh-2",
        "autoParsed": true
      },
      "settings": {
        "shuffleOptions": true,
        "partialScoring": false,
        "caseSensitive": false
      },
      "accessibility": {
        "altText": "",
        "transcript": "",
        "captions": ""
      },
      "options": [
        {
          "id": "A",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Bạn gái đang chạy theo quả bóng."
              }
            ]
          }
        },
        {
          "id": "B",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Bạn gái bị vấp ngã và đau chân."
              }
            ]
          }
        },
        {
          "id": "C",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Bạn gái đang chơi thể thao."
              }
            ]
          }
        },
        {
          "id": "D",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Bạn gái đang đi học bình thường, vui vẻ. b) Bộ phận nào của cơ thể bạn đã bị thương?"
              }
            ]
          }
        },
        {
          "id": "A",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Tay."
              }
            ]
          }
        },
        {
          "id": "B",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Đầu."
              }
            ]
          }
        },
        {
          "id": "C",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Bàn chân."
              }
            ]
          }
        },
        {
          "id": "D",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Vai. c) Khi bị thương như vậy, bạn sẽ gặp khó khăn nào?"
              }
            ]
          }
        },
        {
          "id": "A",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Không thể nói chuyện."
              }
            ]
          }
        },
        {
          "id": "B",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Không thể nhìn rõ."
              }
            ]
          }
        },
        {
          "id": "C",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Đi lại khó khăn."
              }
            ]
          }
        },
        {
          "id": "D",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Khó cầm bút viết. d) Nếu học cùng lớp bạn trong hình, em sẽ làm gì với bạn?"
              }
            ]
          }
        },
        {
          "id": "A",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Trêu chọc bạn vì đi lại chậm."
              }
            ]
          }
        },
        {
          "id": "B",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Không quan tâm vì đó không phải việc của mình."
              }
            ]
          }
        },
        {
          "id": "C",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Giúp bạn mang cặp sách hoặc đi chậm cùng bạn."
              }
            ]
          }
        },
        {
          "id": "D",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Rủ bạn chạy nhanh cho quen dần."
              }
            ]
          }
        }
      ]
    }
  ]
