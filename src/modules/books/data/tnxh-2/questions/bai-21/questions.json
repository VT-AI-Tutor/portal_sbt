      "language": "vi",
      "content": {
        "blocks": [
          {
            "type": "paragraph",
            "text": "Viết số thích hợp tương ứng với các từ cho sẵn vào chỗ (…) để hoàn thành các câu sau:  Cơ quan vận động gồm bộ xương và ......... Cơ và xương giúp cơ thể em ......... và thực hiện các hoạt động hằng ngày. Nhờ cơ quan vận động, em có thể đi lại và ......... đồ vật."
          }
        ]
      },
      "explanation": {
        "blocks": []
      },
      "hint": {
        "blocks": []
      },
      "metadata": {
        "lessonNumber": 21,
        "exerciseNumber": 4,
        "subPart": "",
        "bookId": "tnxh-2",
        "autoParsed": true
      },
      "settings": {
