        },
        {
          "id": "s5",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Đựng nước lau sàn trong chai nước ngọt cũ nhưng vẫn giữ nguyên nhãn mác."
              }
            ]
          },
          "correctAnswer": false
        },
