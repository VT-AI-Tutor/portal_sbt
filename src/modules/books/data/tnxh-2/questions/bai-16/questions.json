      ],
      "language": "vi",
      "content": {
        "blocks": [
          {
            "type": "paragraph",
            "text": "Quan sát hi ̀nh dưới đây. Nếu là bạn nam trong hi ̀nh, em sẽ ứng xử như thế nào với bạn nữ?  Khoanh vào chữ cái trước cách ứng xử em lựa chọn."
          }
        ]
      },
      "explanation": {
        "blocks": []
      },
      "hint": {
        "blocks": []
      },
      "metadata": {
        "lessonNumber": 16,
        "exerciseNumber": 5,
        "subPart": "",
        "bookId": "tnxh-2",
        "autoParsed": true
      },
      "settings": {
        "partialScoring": true,
        "shuffleOptions": true
      },
      "accessibility": {
        "altText": "",
        "transcript": "",
        "captions": ""
      },
      "options": [
        {
          "id": "A",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Bảo bạn cắt hoa về trồng là được, còn gốc thì để lại dưới ao cho cây ra hoa tiếp."
              }
            ]
          }
        },
        {
          "id": "B",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Đồng ý với bạn và cùng nhau xuống ao nhổ thật nhiều cây mang về trồng."
              }
            ]
          }
        },
        {
          "id": "C",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Bảo bạn nhổ cây mang về, còn mình thì đứng trên bờ xem."
              }
            ]
          }
        },
        {
          "id": "D",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Khuyên bạn không nên nhổ vì hái hoa ở ao rất nguy hiểm và hoa súng sống dưới nước, nếu trồng vào chậu đất cây sẽ chết."
              }
            ]
          }
        }
      ]
    },
