      "language": "vi",
      "content": {
        "blocks": [
          {
            "type": "paragraph",
            "text": "Khoanh vào chữ cái trước cách ứng xử của em trong tình huống sau: Nhà Nam ở gần sông, sau cơn mưa to kéo dài cả đêm, nước sông dâng nhanh. Buổi sáng khi mở cửa nhà, Nam thấy nước bắt đầu ngập đến bậc cửa. Nếu là Nam, em sẽ làm gì?"
          }
        ]
      },
      "explanation": {
        "blocks": []
      },
      "hint": {
        "blocks": []
      },
      "metadata": {
        "lessonNumber": 30,
        "exerciseNumber": 3,
        "subPart": "",
        "bookId": "tnxh-2",
        "autoParsed": true
      },
      "settings": {
        "shuffleOptions": true,
        "partialScoring": false,
        "caseSensitive": false
      },
      "accessibility": {
        "altText": "",
        "transcript": "",
        "captions": ""
      },
      "options": [
        {
          "id": "A",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Lội ra chỗ nước ngập để nghịch nước và thả thuyền giấy."
              }
            ]
          }
        },
        {
          "id": "B",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Nhanh chóng cùng bố mẹ di chuyển lên tầng cao hoặc nơi cao ráo."
              }
            ]
          }
        },
        {
          "id": "C",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Nói với bố mẹ cho đi xem nước lũ ở các khu vực xung quanh."
              }
            ]
          }
        },
        {
          "id": "D",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Tự mình lội và bơi qua dòng nước lũ để sang nhà bạn chơi."
              }
            ]
          }
        }
      ]
