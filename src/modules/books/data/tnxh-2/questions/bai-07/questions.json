      "options": [
        {
          "id": "A",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Để trang trí cho không gian ngày hội đọc sách thêm đẹp mắt."
              }
            ]
          }
        },
        {
          "id": "B",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Để học sinh dễ dàng tìm kiếm và lựa chọn cuốn sách phù hợp với mình."
              }
            ]
          }
        },
        {
          "id": "C",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Để sau khi kết thúc có thể thu dọn nhanh hơn."
              }
            ]
          }
        },
        {
          "id": "D",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Để cất sách đi không sử dụng nữa."
              }
            ]
          }
        }
      ]
