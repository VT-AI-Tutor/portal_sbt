    {
      "id": "tnxh2_bai24_q4",
      "type": "single_choice",
      "version": 1,
      "difficulty": "medium",
      "score": 1,
      "tags": [
        "tnxh_2",
        "grade_2",
        "bai_24"
      ],
      "language": "vi",
      "content": {
        "blocks": [
          {
            "type": "paragraph",
            "text": "Quan sát hình dưới đây. Nếu là bạn nam trong hình em sẽ trả lời câu hỏi của em gái như thế nào? Khoanh vào chữ cái trước câu trả lời đúng."
          }
        ]
      },
      "explanation": {
        "blocks": []
      },
      "hint": {
        "blocks": []
      },
      "metadata": {
        "lessonNumber": 24,
        "exerciseNumber": 4,
        "subPart": "",
        "bookId": "tnxh-2",
        "autoParsed": true
      },
      "settings": {
        "shuffleOptions": true,
        "partialScoring": false,
        "caseSensitive": false
      },
      "accessibility": {
        "altText": "",
        "transcript": "",
        "captions": ""
      },
      "options": [
        {
          "id": "A",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Vì nước muối giúp miệng và cổ họng sạch hơn, hạn chế mầm bệnh gây hại cho cơ quan hô hấp. Em súc miệng bằng nước muối rồi hãy đi ngủ nhé!"
              }
            ]
          }
        },
        {
          "id": "B",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Vì nước muối làm miệng và cổ họng có mùi thơm dễ chịu. Vì sao súc miệng bằng nước muối lại tốt cho cơ quan hô hấp ạ?"
              }
            ]
          }
        },
        {
          "id": "C",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Vì súc miệng bằng nước muối giúp răng mọc nhanh hơn."
              }
            ]
          }
        },
        {
          "id": "D",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Vì súc miệng bằng nước muối giúp cổ họng không bị khô."
              }
            ]
          }
        }
      ]
    },
    {
      "id": "tnxh2_bai24_q5",
      "type": "multiple_choice",
      "version": 1,
      "difficulty": "medium",
      "score": 1,
      "tags": [
        "tnxh_2",
        "grade_2",
        "bai_24"
      ],
      "language": "vi",
      "content": {
        "blocks": [
          {
            "type": "paragraph",
            "text": "Nếu là bạn nam trong tình huống ở hi ̀nh sau, em sẽ nói gì? Khoanh vào chữ cái trước lời nói mà em chọn."
          }
        ]
      },
      "explanation": {
        "blocks": []
      },
      "hint": {
        "blocks": []
      },
      "metadata": {
        "lessonNumber": 24,
        "exerciseNumber": 5,
        "subPart": "",
        "bookId": "tnxh-2",
        "autoParsed": true
      },
      "settings": {
        "partialScoring": true,
        "shuffleOptions": true
      },
      "accessibility": {
        "altText": "",
        "transcript": "",
        "captions": ""
      },
      "options": [
        {
          "id": "A",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "“Chú hút thuốc làm cháu khó chịu lắm!”"
              }
            ]
          }
        },
        {
          "id": "B",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "“Chú không được hút thuốc ở đây!” Khói thuốc làm mình khó thở quá! ?"
              }
            ]
          }
        },
        {
          "id": "C",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "“Chú ơi, ở đây có nhiều người và trẻ em, chú có thể không hút thuốc ở đây được không ạ?”"
              }
            ]
          }
        },
        {
          "id": "D",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "“Chú đi ra chỗ khác để cho chúng cháu lấy chỗ chơi ạ!”"
              }
            ]
          }
        }
      ]
    }
