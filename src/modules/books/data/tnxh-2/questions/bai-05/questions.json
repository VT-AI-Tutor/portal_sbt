      },
      "options": [
        {
          "id": "A",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Cảm ơn mẹ và hứa sẽ giữ gìn áo cẩn thận. ?"
              }
            ]
          }
        },
        {
          "id": "B",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Nhận áo và mặc ngay vào mà không nói gì."
              }
            ]
          }
        },
        {
          "id": "C",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Cầm áo và chạy đi khoe với bạn ngay lập tức."
              }
            ]
          }
        },
        {
          "id": "D",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Im lặng không nói gì vì thấy áo không đẹp. Tình huống 2 ?"
              }
            ]
          }
        },
        {
          "id": "A",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Quát mắng và đánh vào tay em để em sợ."
              }
            ]
          }
        },
        {
          "id": "B",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Nhẹ nhàng ngăn em lại, sau đó cất vỉ thuốc vào tủ thuốc."
              }
            ]
          }
        },
        {
          "id": "C",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Chạy đi báo cho bố mẹ để bố mẹ cất vỉ thuốc lên chỗ cao."
              }
            ]
          }
        },
        {
          "id": "D",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Lấy vỉ thuốc đưa cho em chơi."
              }
            ]
          }
        }
      ]
