      "content": {
        "blocks": [
          {
            "type": "paragraph",
            "text": "Quan sát các tình huống dưới đây và khoanh vào chữ cái trước cách ứng xử mà em chọn.  Tình huống 1"
          }
        ]
      },
      "explanation": {
        "blocks": []
      },
