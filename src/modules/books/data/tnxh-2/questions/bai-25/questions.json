          "id": "A",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Vì bóng đái chứa quá nhiều nước tiểu so với bình thường."
              }
            ]
          }
        },
        {
          "id": "B",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Vì ống dẫn nước tiểu bị tắc, không cho nước tiểu đi xuống."
              }
            ]
          }
        },
        {
          "id": "C",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Vì thận ngừng hoạt động."
              }
            ]
          }
        },
        {
          "id": "D",
          "content": {
            "blocks": [
              {
                "type": "paragraph",
                "text": "Vì bóng đái căng, gây đau tức ở bụng dưới."
